# Copy this file to secrets.yaml and fill in your own values.
# secrets.yaml is listed in .gitignore and will never be committed.

wifi_ssid: "YourWiFiName"
wifi_password: "YourWiFiPassword"
ap_password: "FallbackHotspotPassword"   # 8+ characters

ota_password: "YourOTAPassword"

mqtt_host: "192.168.1.100"   # broker IP address (IP is more reliable than a .local name)
mqtt_user: "mqtt_username"
mqtt_password: "mqtt_password"
